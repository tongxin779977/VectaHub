{
  "name": "vectahub-vscode-extension",
  "displayName": "VectaHub 任务助手",
  "description": "为 VectaHub CLI 提供自然语言工作流 UI 界面",
  "version": "0.1.0",
  "publisher": "vectahub",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tongxin779977/VectaHub"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Productivity",
    "Other"
  ],
  "keywords": [
    "vectahub",
    "workflow",
    "tasks",
    "cli",
    "automation",
    "natural language"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vectahub",
          "title": "VectaHub",
          "icon": "$(tasklist)"
        }
      ]
    },
    "views": {
      "vectahub": [
        {
          "id": "vectahubTasks.tasksView",
          "name": "任务面板"
        },
        {
          "id": "vectahubTasks.advancedView",
          "name": "高级选项"
        }
      ]
    },
    "commands": [
      {
        "command": "vectahubTasks.previewIntent",
        "title": "VectaHub: 预览意图",
        "category": "VectaHub"
      },
      {
        "command": "vectahubTasks.refreshProjectTasks",
        "title": "刷新任务列表",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vectahubTasks.refreshProjectTasks",
          "when": "view == vectahubTasks.tasksView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "VectaHub 配置",
      "properties": {
        "vectahubTasks.cliPath": {
          "type": "string",
          "default": "vectahub",
          "description": "VectaHub CLI 可执行文件路径"
        },
        "vectahubTasks.executionMode": {
          "type": "string",
          "enum": [
            "strict",
            "relaxed",
            "consensus"
          ],
          "default": "strict",
          "description": "默认执行模式"
        },
        "vectahubTasks.previewBeforeRun": {
          "type": "boolean",
          "default": true,
          "description": "执行前是否强制预览"
        },
        "vectahubTasks.autoDetectCli": {
          "type": "boolean",
          "default": true,
          "description": "插件激活后是否自动检测 CLI"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/test-electron": "^2.3.0",
    "eslint": "^8.45.0",
    "typescript": "^5.6.0"
  }
}
