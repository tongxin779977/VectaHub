{
  "name": "vectahub",
  "version": "1.0.13",
  "type": "module",
  "description": "VectaHub - Natural Language Workflow Engine",
  "main": "dist/index.js",
  "bin": {
    "vectahub": "dist/cli.js"
  },
  "scripts": {
    "bump": "node scripts/bump-version.mjs",
    "build": "tsup",
    "build:watch": "tsup --watch",
    "dev": "tsx src/cli.ts",
    "check:default-context-usage": "node scripts/check-default-context-usage.mjs",
    "test": "vitest",
    "test:run": "vitest --run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "compile:extension": "npm run compile -w packages/vectahub-vscode-extension",
    "package:vsix": "npm run compile -w packages/vectahub-vscode-extension && cd packages/vectahub-vscode-extension && rm -f ../.DS_Store && find . -name '.DS_Store' -delete && npx vsce package --allow-missing-repository --no-yarn --no-dependencies",
    "release": "npm run bump && npm run build && npm run package:vsix && npm link",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "workflow",
    "automation",
    "cli",
    "llm",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "commander": "14.0.3",
    "json-logic-js": "2.0.5",
    "lodash": "4.18.1",
    "pino": "10.3.1",
    "shell-quote": "1.8.3",
    "yaml": "2.8.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/json-logic-js": "2.0.8",
    "@types/node": "22.19.18",
    "globals": "17.6.0",
    "pino-pretty": "13.1.3",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.2",
    "vitest": "4.1.5"
  },
  "engines": {
    "node": ">=21.0.0"
  },
  "files": [
    "dist"
  ]
}
