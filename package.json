{
  "name": "vectahub",
  "version": "1.0.6",
  "type": "module",
  "description": "VectaHub - Natural Language Workflow Engine",
  "main": "dist/index.js",
  "bin": {
    "vectahub": "dist/cli.js"
  },
  "scripts": {
    "bump": "node scripts/bump-version.mjs",
    "build": "tsup",
    "build:watch": "tsup --watch",
    "dev": "tsx src/cli.ts",
    "test": "vitest",
    "test:run": "vitest --run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "compile:extension": "npm run compile -w packages/vectahub-vscode-extension",
    "package:vsix": "npm run compile -w packages/vectahub-vscode-extension && cd packages/vectahub-vscode-extension && rm -f ../.DS_Store && find . -name '.DS_Store' -delete && npx vsce package --allow-missing-repository --no-yarn",
    "release": "npm run bump && npm run build && npm run package:vsix && npm link",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "workflow",
    "automation",
    "cli",
    "llm",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "commander": "^14.0.3",
    "json-logic-js": "^2.0.5",
    "lodash": "^4.18.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/json-logic-js": "^2.0.8",
    "@types/node": "^22.0.0",
    "globals": "^17.6.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=21.0.0"
  },
  "files": [
    "dist"
  ]
}
