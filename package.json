{
  "name": "vectahub",
  "version": "1.0.43",
  "type": "module",
  "description": "VectaHub - Natural Language Workflow Engine",
  "main": "dist/index.js",
  "bin": {
    "vectahub": "dist/cli.js"
  },
  "scripts": {
    "bump": "node scripts/bump-version.mjs",
    "build": "tsup",
    "build:watch": "tsup --watch",
    "dev": "tsx src/cli.ts",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:default-context-usage": "node scripts/check-default-context-usage.mjs",
    "check:coverage": "node scripts/check-coverage-threshold.mjs",
    "check:bench": "node scripts/check-bench-regression.mjs",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:coverage": "vitest --run --coverage --exclude '**/packages/vectahub-vscode-extension/**'",
    "bench": "vitest bench --run --outputJson benchmarks/results/latest.json --exclude '**/packages/vectahub-vscode-extension/**'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "commit": "npm run bump && npm run build && git add . && git commit",
    "compile:extension": "npm run compile -w packages/vectahub-vscode-extension",
    "package:vsix": "npm run compile -w packages/vectahub-vscode-extension && cd packages/vectahub-vscode-extension && rm -f ../.DS_Store && find . -name '.DS_Store' -delete && npx @vscode/vsce package --allow-missing-repository --no-dependencies",
    "release": "npm run bump && npm run build && npm run package:vsix && npm link",
    "prepublishOnly": "npm run build",
    "e2e": "playwright test",
    "e2e:server": "node dist/cli.js repl --port 7777",
    "mutation": "stryker run",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "keywords": [
    "workflow",
    "automation",
    "cli",
    "llm",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "commander": "14.0.3",
    "json-logic-js": "2.0.5",
    "lodash": "4.18.1",
    "pino": "10.3.1",
    "shell-quote": "^1.9.0",
    "yaml": "2.8.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.61.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/json-logic-js": "2.0.8",
    "@types/node": "22.19.18",
    "@vitest/coverage-v8": "^4.1.5",
    "globals": "17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "pino-pretty": "13.1.3",
    "prettier": "^3.9.4",
    "tsup": "8.5.1",
    "tsx": "^4.22.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.2",
    "vitest": "4.1.5"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "fast-uri": "4.1.1",
    "js-yaml": "4.3.0",
    "linkify-it": "5.0.2",
    "postcss": "8.5.24",
    "qs": "6.15.3"
  },
  "engines": {
    "node": ">=21.0.0"
  },
  "files": [
    "dist"
  ]
}
